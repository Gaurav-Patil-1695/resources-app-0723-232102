# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────

# Node environment: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=3000

# ─────────────────────────────────────────────
# Database (PostgreSQL — development / production)
# ─────────────────────────────────────────────

# Hostname or IP of the PostgreSQL server
DB_HOST=127.0.0.1

# PostgreSQL port (default: 5432)
DB_PORT=5432

# Name of the target database
DB_NAME=app_development

# PostgreSQL login user
DB_USER=postgres

# PostgreSQL login password
DB_PASSWORD=

# Set to "false" to disable SSL certificate verification in production
DB_SSL_REJECT_UNAUTHORIZED=true

# ─────────────────────────────────────────────
# Database (PostgreSQL — test environment)
# ─────────────────────────────────────────────

TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=app_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────

# Secret used to sign JSON Web Tokens — must be a long random string
JWT_SECRET=replace_me_with_a_long_random_secret

# JWT expiry duration (ms / zeit/ms format, e.g. "15m", "1h", "7d")
JWT_EXPIRES_IN=1h

# Number of bcrypt salt rounds (10–14 recommended)
BCRYPT_SALT_ROUNDS=12

# ─────────────────────────────────────────────
# Elasticsearch
# ─────────────────────────────────────────────

# Full URL of the Elasticsearch node
ELASTICSEARCH_NODE=http://localhost:9200

# Optional: Elasticsearch API key for cloud deployments
ELASTICSEARCH_API_KEY=

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────

# Window size in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests allowed per window per IP
RATE_LIMIT_MAX=100

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────

# Winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Directory where log files are written
LOG_DIR=logs

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────

# Comma-separated list of allowed origins (use * for development only)
CORS_ALLOWED_ORIGINS=http://localhost:3000
